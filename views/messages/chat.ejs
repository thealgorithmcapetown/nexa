
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Chat with <%= otherShop.name %> | NEXA</title>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/chat.css">

</head>

<body>

    <!-- SHARED NAVIGATION -->

    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>


    <main class="nexa-main chat-page">

        <!-- BACK LINK -->

        <a href="/messages" class="chat-back-link">

            <i data-lucide="arrow-left"></i>

            All messages

        </a>


        <!-- CHAT WINDOW -->

        <section class="chat-window">

            <!-- CHAT HEADER -->

            <header class="chat-header">

                <div class="chat-header-identity">

                    <div class="chat-shop-avatar">
                        <i data-lucide="store"></i>
                    </div>

                    <div class="chat-header-details">

                        <span class="chat-header-eyebrow">
                            VENDOR CONVERSATION
                        </span>

                        <h1>
                            <%= otherShop.name %>
                        </h1>

                        <p>
                            <i data-lucide="shield-check"></i>
                            NEXA messaging
                        </p>

                    </div>

                </div>

                <a
                    href="/messages"
                    class="chat-header-close"
                    aria-label="Back to messages"
                >
                    <i data-lucide="x"></i>
                </a>

            </header>


            <!-- TRADE CONTEXT -->

            <% if (tradeRequest) { %>

                <div class="chat-trade-banner">

                    <div class="chat-trade-icon">
                        <i data-lucide="package"></i>
                    </div>

                    <div class="chat-trade-details">

                        <span>TRADE DISCUSSION</span>

                        <strong>
                            <%= tradeRequest.product %>
                        </strong>

                        <p>
                            <%= tradeRequest.quantity %>
                            <%= tradeRequest.unit %>
                            <span class="chat-trade-separator">•</span>
                            Budget R<%= Number(tradeRequest.budget).toLocaleString('en-ZA') %>
                        </p>

                    </div>

                    <a
                        href="/trade/<%= tradeRequest._id %>"
                        class="chat-trade-link"
                        aria-label="View trade request"
                    >
                        <i data-lucide="arrow-up-right"></i>
                    </a>

                </div>

            <% } %>


            <!-- MESSAGES AREA -->

            <div
                id="messages-container"
                class="chat-messages"
                role="log"
                aria-label="Conversation messages"
                aria-live="polite"
                aria-relevant="additions"
            >

                <% if (messages.length === 0) { %>

                    <div id="no-messages" class="chat-empty-state">

                        <div class="chat-empty-icon">
                            <i data-lucide="messages-square"></i>
                        </div>

                        <h2>Start the conversation</h2>

                        <p>
                            Say hello and discuss the details
                            of your trade.
                        </p>

                    </div>

                <% } %>


                <% messages.forEach(message => { %>

                    <%
                        const isMine =
                            message.sender._id.toString() ===
                            currentShopId.toString();
                    %>

                    <div class="message-row <%= isMine ? 'mine' : 'theirs' %>">

                        <div class="message-bubble">

                            <strong>
                                <%= isMine ? "You" : message.sender.name %>
                            </strong>

                            <p>
                                <%= message.content %>
                            </p>

                            <small>
                                <%= message.createdAt.toLocaleTimeString(
                                    [],
                                    {
                                        hour: "2-digit",
                                        minute: "2-digit"
                                    }
                                ) %>
                            </small>

                        </div>

                    </div>

                <% }) %>

            </div>


            <!-- COMPOSER WRAPPER -->

            <div class="chat-composer-wrapper">

                <!-- COMMUNICATION REMINDER -->

                <div class="chat-respect-reminder">

                    <i data-lucide="shield-check"></i>

                    <span>
                        Keep messages clear and respectful.
                    </span>

                </div>


                <!-- MESSAGE COMPOSER -->

                <form
                    id="chat-form"
                    class="chat-composer"
                    action="/messages/<%= otherShop._id %><%= tradeRequest ? '?trade=' + tradeRequest._id : '' %>"
                    method="POST"
                >

                    <textarea
                        id="message-input"
                        name="content"
                        placeholder="Type your message..."
                        aria-label="Type your message"
                        rows="1"
                        required
                    ></textarea>

                    <button
                        type="submit"
                        class="chat-send-button"
                        aria-label="Send message"
                    >
                        <i data-lucide="send"></i>
                    </button>

                </form>

            </div>

        </section>

    </main>


    <!-- SHARED SCRIPTS -->

    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script src="/js/navigation.js"></script>

    <script src="/socket.io/socket.io.js"></script>


    <!-- EXISTING CHAT DATA -->

    <script>

        window.chatData = {

            currentShopId:
                "<%= currentShopId %>",

            otherShopId:
                "<%= otherShop._id %>",

            otherShopName:
                "<%= otherShop.name %>",

            tradeId:
                "<%= tradeRequest ? tradeRequest._id : '' %>"

        };

    </script>


    <!-- EXISTING REAL-TIME CHAT -->

    <script src="/js/chat.js"></script>

</body>

</html>
