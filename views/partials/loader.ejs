
<!-- ========================================
     NEXA — GLOBAL LOADING SCREEN
======================================== -->

<div
    id="nexaLoader"
    class="nexa-loader"
    role="status"
    aria-label="Loading NEXA"
    hidden
>

    <div class="nexa-loader-content">

        <!-- Spinning NEXA Icon -->
        <img
            src="/images/branding/nexa-loading-icon.png"
            alt=""
            class="nexa-loader-icon"
            fetchpriority="high"
            decoding="sync"
            width="72"
            height="72"
        >

        <!-- Changing Loading Messages -->
        <p
            id="nexaLoaderMessage"
            class="nexa-loader-message"
        >
            Bettering your experience...
        </p>

        <!-- Animated Progress Bar -->
        <div class="nexa-loader-track">
            <div class="nexa-loader-bar"></div>
        </div>

    </div>

</div>
