
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>

    <title>Settings - NEXA</title>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/footer.css">
    <link rel="stylesheet" href="/css/shop-account.css">
    <link rel="stylesheet" href="/css/loader.css">

</head>

<body>

    <%- include('../partials/loader') %>
    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>

    <main class="nexa-main account-page">

        <header class="account-page-header">

            <div>

                <span class="account-eyebrow">
                    PERSONAL ACCOUNT
                </span>

                <h1>
                    Settings<span class="nexa-title-dot">.</span>
                </h1>

                <p>
                    Manage your account, security, and payment wallet.
                </p>

            </div>

            <a href="/shop" class="account-btn account-btn-outline">

                <i data-lucide="store"></i>

                My Shop

            </a>

        </header>

        <div class="account-settings-layout">

            <section class="account-panel">

                <div class="account-panel-heading">

                    <div class="account-panel-icon">
                        <i data-lucide="user-round"></i>
                    </div>

                    <div>

                        <span class="account-eyebrow">
                            YOUR DETAILS
                        </span>

                        <h2>Account Details</h2>

                        <p>
                            Manage the information linked to your account.
                        </p>

                    </div>

                </div>

                <form action="/settings" method="POST">

                    <div class="account-form-grid">

                        <div class="account-field">

                            <label for="name">
                                Name <em>*</em>
                            </label>

                            <input
                                type="text"
                                id="name"
                                name="name"
                                value="<%= user.name %>"
                                autocomplete="name"
                                required
                            >

                        </div>

                        <div class="account-field">

                            <label for="email">
                                Email <em>*</em>
                            </label>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                value="<%= user.email %>"
                                autocomplete="email"
                                required
                            >

                        </div>

                        <div class="account-field account-field-full">

                            <label for="phone">
                                Phone
                            </label>

                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                value="<%= user.phone || '' %>"
                                placeholder="Phone number"
                                autocomplete="tel"
                            >

                        </div>

                    </div>

                    <div class="account-form-actions">

                        <button
                            type="submit"
                            class="account-btn account-btn-primary"
                        >

                            <i data-lucide="save"></i>
                            Save Settings

                        </button>

                    </div>

                </form>

            </section>

            <section class="account-panel">

                <div class="account-panel-heading">

                    <div class="account-panel-icon">
                        <i data-lucide="shield-check"></i>
                    </div>

                    <div>

                        <span class="account-eyebrow">
                            ACCOUNT SECURITY
                        </span>

                        <h2>Change Password</h2>

                        <p>
                            Use a strong password to protect your account.
                        </p>

                    </div>

                </div>

                <form
                    action="/settings/password"
                    method="POST"
                    id="account-password-form"
                >

                    <div class="account-form-grid">

                        <div class="account-field account-field-full">

                            <label for="currentPassword">
                                Current Password <em>*</em>
                            </label>

                            <input
                                type="password"
                                id="currentPassword"
                                name="currentPassword"
                                autocomplete="current-password"
                                required
                            >

                        </div>

                        <div class="account-field account-field-full">

                            <label for="newPassword">
                                New Password <em>*</em>
                            </label>

                            <input
                                type="password"
                                id="newPassword"
                                name="newPassword"
                                minlength="8"
                                autocomplete="new-password"
                                required
                            >

                            <small>
                                At least 8 characters.
                            </small>

                        </div>

                        <div class="account-field account-field-full">

                            <label for="confirmPassword">
                                Confirm New Password <em>*</em>
                            </label>

                            <input
                                type="password"
                                id="confirmPassword"
                                name="confirmPassword"
                                minlength="8"
                                autocomplete="new-password"
                                required
                            >

                        </div>

                    </div>

                    <p
                        id="password-match-error"
                        class="account-validation-error"
                        role="alert"
                        hidden
                    >
                        New passwords do not match.
                    </p>

                    <div class="account-form-actions">

                        <button
                            type="submit"
                            class="account-btn account-btn-primary"
                        >

                            <i data-lucide="lock-keyhole"></i>
                            Change Password

                        </button>

                    </div>

                </form>

            </section>

            <section class="account-panel account-wallet-settings-panel">

                <div class="account-panel-heading">

                    <div class="account-panel-icon">
                        <i data-lucide="wallet"></i>
                    </div>

                    <div>

                        <span class="account-eyebrow">
                            PAYMENT SETTINGS
                        </span>

                        <h2>Payment Wallet</h2>

                        <p>
                            Manage your shop's Open Payments wallet address.
                        </p>

                    </div>

                </div>

                <div class="account-wallet-status-row">

                    <% if (shop.walletAddress) { %>

                        <span class="account-status account-status-ready">

                            <i data-lucide="check-circle-2"></i>

                            Wallet Configured

                        </span>

                    <% } else { %>

                        <span class="account-status">

                            <i data-lucide="alert-circle"></i>

                            No Wallet Configured

                        </span>

                    <% } %>

                </div>

                <p class="account-help">
                    Your wallet address is used for Open Payments.
                    You can add or change it at any time.
                </p>

                <form
                    action="/settings/wallet"
                    method="POST"
                    id="account-wallet-form"
                >

                    <div class="account-form-grid">

                        <div class="account-field account-field-full">

                            <label for="walletAddress">
                                Open Payments Wallet Address
                            </label>

                            <input
                                type="text"
                                id="walletAddress"
                                name="walletAddress"
                                value="<%= shop.walletAddress || '' %>"
                                placeholder="$ilp.interledger-test.dev/yourname"
                                autocomplete="off"
                                autocapitalize="none"
                                spellcheck="false"
                            >

                            <small>
                                Enter your wallet address starting with
                                $ or https://. Saving an address does not
                                automatically authorize or verify the wallet.
                            </small>

                        </div>

                    </div>

                    <div class="account-form-actions account-wallet-actions">

                        <% if (shop.walletAddress) { %>

                            <button
                                type="submit"
                                form="account-wallet-remove-form"
                                class="account-btn account-btn-danger"
                                id="removeWalletButton"
                            >

                                <i data-lucide="trash-2"></i>
                                Remove Wallet

                            </button>

                        <% } %>

                        <button
                            type="submit"
                            class="account-btn account-btn-primary"
                        >

                            <i data-lucide="save"></i>
                            Save Wallet

                        </button>

                    </div>

                </form>

                <form
                    action="/settings/wallet/remove"
                    method="POST"
                    id="account-wallet-remove-form"
                ></form>

                <div class="account-wallet-notice">

                    <i data-lucide="info"></i>

                    <p>
                        A configured wallet address is not the same
                        as an authorized payment connection.
                        Wallet verification and payment permissions
                        will be handled separately.
                    </p>

                </div>

            </section>

        </div>

        <a href="/dashboard" class="account-back">

            <i data-lucide="arrow-left"></i>
            Back to Dashboard

        </a>

    </main>

    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script src="/js/navigation.js"></script>

    <script>

        if (window.lucide) {
            lucide.createIcons();
        }

        const passwordForm =
            document.getElementById("account-password-form");

        const passwordError =
            document.getElementById("password-match-error");

        const newPassword =
            document.getElementById("newPassword");

        const confirmPassword =
            document.getElementById("confirmPassword");

        passwordForm.addEventListener("submit", function (event) {

            const matches =
                newPassword.value === confirmPassword.value;

            passwordError.hidden = matches;

            confirmPassword.setCustomValidity(
                matches ? "" : "Passwords do not match"
            );

            if (!matches) {

                event.preventDefault();

                confirmPassword.reportValidity();

            }

        });

        confirmPassword.addEventListener("input", function () {

            this.setCustomValidity("");
            passwordError.hidden = true;

        });

        newPassword.addEventListener("input", function () {

            confirmPassword.setCustomValidity("");
            passwordError.hidden = true;

        });

        const walletForm =
            document.getElementById("account-wallet-form");

        const walletInput =
            document.getElementById("walletAddress");

        function validWalletAddress(walletAddress) {

            const value = String(walletAddress || "").trim();

            if (!value || /\s/.test(value)) {
                return false;
            }

            try {

                const normalized = value.startsWith("$")
                    ? `https://${value.slice(1)}`
                    : value;

                const url = new URL(normalized);

                return (
                    url.protocol === "https:" &&
                    Boolean(url.hostname) &&
                    !url.username &&
                    !url.password &&
                    !url.hash
                );

            } catch (error) {
                return false;
            }

        }

        walletInput.addEventListener("input", function () {

            this.setCustomValidity("");

        });

        walletForm.addEventListener("submit", function (event) {

            const walletAddress = walletInput.value.trim();

            walletInput.setCustomValidity("");

            if (!validWalletAddress(walletAddress)) {

                event.preventDefault();

                walletInput.setCustomValidity(
                    "Enter a valid wallet address, for example $ilp.interledger-test.dev/yourname"
                );

                walletInput.reportValidity();

                return;

            }

            walletInput.value = walletAddress;

        });

        const removeWalletButton =
            document.getElementById("removeWalletButton");

        if (removeWalletButton) {

            removeWalletButton.addEventListener("click", function (event) {

                const confirmed = window.confirm(
                    "Remove your saved wallet address? You can add another wallet later."
                );

                if (!confirmed) {
                    event.preventDefault();
                }

            });

        }

    </script>

    <script src="/js/loader.js"></script>

    <%- include('../partials/footer') %>

</body>

</html>
