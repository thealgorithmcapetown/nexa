<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('../partials/head') %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= shop.name %> - NEXA</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/shop-account.css">
</head>
<body>
    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>

    <main class="nexa-main account-page">
        <header class="account-page-header">
            <div>
                <span class="account-eyebrow">YOUR BUSINESS</span>
                <h1>My Shop<span class="nexa-title-dot">.</span></h1>
                <p>Manage your business identity and payment information.</p>
            </div>
            <a href="/shop/edit" class="account-btn account-btn-primary"><i data-lucide="pencil"></i> Edit Shop</a>
        </header>

        <section class="account-profile-hero">
            <div class="account-shop-avatar"><i data-lucide="store"></i></div>
            <div class="account-profile-identity">
                <span class="account-eyebrow">BUSINESS PROFILE</span>
                <h2><%= shop.name %></h2>
                <p><i data-lucide="map-pin"></i> <%= shop.address %></p>
            </div>
            <div class="account-rating">
                <i data-lucide="star"></i>
                <span><%= shop.rating != null ? shop.rating : 'Not rated' %></span>
                <small>Shop rating</small>
            </div>
        </section>

        <div class="account-content-grid">
            <section class="account-panel">
                <div class="account-panel-heading">
                    <div class="account-panel-icon"><i data-lucide="store"></i></div>
                    <div><span class="account-eyebrow">ABOUT YOUR BUSINESS</span><h2>Shop Information</h2></div>
                </div>
                <div class="account-info-grid">
                    <div class="account-info-item"><span>Shop Name</span><strong><%= shop.name %></strong></div>
                    <div class="account-info-item"><span>Category</span><strong><%= shop.category || 'Not set' %></strong></div>
                    <div class="account-info-item account-info-wide"><span>Address</span><strong><%= shop.address %></strong></div>
                    <div class="account-info-item account-info-wide"><span>Description</span><p><%= shop.description || 'No description yet.' %></p></div>
                </div>
            </section>

            <aside class="account-panel account-wallet-panel">
                <div class="account-panel-heading">
                    <div class="account-panel-icon"><i data-lucide="wallet"></i></div>
                    <div><span class="account-eyebrow">PAYMENT DETAILS</span><h2>Open Payments Wallet</h2></div>
                </div>
                <% if (shop.walletAddress) { %>
                    <span class="account-status account-status-ready"><i data-lucide="check-circle-2"></i> Wallet configured</span>
                    <div class="account-wallet-value"><%= shop.walletAddress %></div>
                    <p class="account-help">This wallet is used to receive NEXA payments.</p>
                <% } else { %>
                    <span class="account-status"><i data-lucide="alert-circle"></i> Not configured</span>
                    <p class="account-help">Add an Open Payments wallet address to your shop profile.</p>
                    <a href="/shop/edit" class="account-btn account-btn-outline">Configure Wallet <i data-lucide="arrow-up-right"></i></a>
                <% } %>
            </aside>
        </div>
        <a href="/dashboard" class="account-back"><i data-lucide="arrow-left"></i> Back to Dashboard</a>
    </main>
    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>
    <script src="/js/navigation.js"></script>
    <script>if (window.lucide) lucide.createIcons();</script>
</body>
</html>
