<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Transactions - NEXA
    </title>

    <link
        rel="stylesheet"
        href="/css/main.css"
    >

</head>

<body>


    <h1>
        Transactions
    </h1>


    <% if (transactions.length === 0) { %>

        <p>
            No transactions yet.
        </p>

    <% } %>


    <% transactions.forEach(transaction => { %>

        <%

            // --------------------------------
            // TRANSACTION TYPE
            // --------------------------------

            const isCustomerPayment =
                transaction.type ===
                "customer_payment";


            // Customer payments do NOT have
            // a fromShop.

            const sent =
                !isCustomerPayment &&
                transaction.fromShop &&
                transaction.fromShop._id
                    .toString() ===
                currentShopId.toString();

        %>


        <div>


            <!-- ============================== -->
            <!-- SENT / RECEIVED -->
            <!-- ============================== -->

            <h3>

                <% if (isCustomerPayment) { %>

                    Payment Received

                <% } else { %>

                    <%= sent
                        ? "Payment Sent"
                        : "Payment Received"
                    %>

                <% } %>

            </h3>


            <!-- ============================== -->
            <!-- PAYMENT TYPE / PRODUCT -->
            <!-- ============================== -->

            <p>

                <strong>

                    <% if (isCustomerPayment) { %>

                        Customer Payment

                    <% } else if (transaction.tradeRequest) { %>

                        <%= transaction.tradeRequest.product %>

                    <% } else { %>

                        Trade Payment

                    <% } %>

                </strong>

            </p>


            <!-- ============================== -->
            <!-- FROM / TO -->
            <!-- ============================== -->

            <p>

                <% if (isCustomerPayment) { %>

                    From:

                    <strong>
                        External Customer
                    </strong>

                <% } else if (sent) { %>

                    To:

                    <strong>

                        <%= transaction.toShop
                            ? transaction.toShop.name
                            : "Unknown Shop"
                        %>

                    </strong>

                <% } else { %>

                    From:

                    <strong>

                        <%= transaction.fromShop
                            ? transaction.fromShop.name
                            : "Unknown Shop"
                        %>

                    </strong>

                <% } %>

            </p>


            <!-- ============================== -->
            <!-- AMOUNT -->
            <!-- ============================== -->

            <p>

                Amount:

                <strong>
                    R<%= Number(transaction.amount).toFixed(2) %>
                </strong>

            </p>


            <!-- ============================== -->
            <!-- REFERENCE -->
            <!-- ============================== -->

            <% if (transaction.reference) { %>

                <p>

                    Reference:

                    <strong>
                        <%= transaction.reference %>
                    </strong>

                </p>

            <% } %>


            <!-- ============================== -->
            <!-- PAYMENT METHOD -->
            <!-- ============================== -->

            <% if (isCustomerPayment) { %>

                <p>
                    Method:

                    <strong>
                        Open Payments + Interledger
                    </strong>
                </p>

            <% } %>


            <!-- ============================== -->
            <!-- STATUS -->
            <!-- ============================== -->

            <p>

                Status:

                <strong>
                    <%= transaction.status %>
                </strong>

            </p>


            <!-- ============================== -->
            <!-- DATE -->
            <!-- ============================== -->

            <p>

                <%= transaction.createdAt.toLocaleString() %>

            </p>


            <!-- ============================== -->
            <!-- RECEIPT -->
            <!-- ============================== -->

            <a href="/transactions/<%= transaction._id %>">

                View Receipt

            </a>


        </div>


        <hr>


    <% }) %>


    <a href="/dashboard">
        Back to Dashboard
    </a>


</body>

</html>