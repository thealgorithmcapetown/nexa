<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Transaction Receipt - NEXA
    </title>

    <link
        rel="stylesheet"
        href="/css/main.css"
    >

</head>

<body>

    <h1>
        Transaction Receipt
    </h1>


    <!-- ============================== -->
    <!-- TRANSACTION TYPE -->
    <!-- ============================== -->

    <p>
        Transaction Type:

        <strong>

            <% if (transaction.type === "customer_payment") { %>

                Customer Payment

            <% } else if (transaction.type === "direct_payment") { %>

                Direct Payment

            <% } else { %>

                Trade Payment

            <% } %>

        </strong>
    </p>


    <!-- ============================== -->
    <!-- REFERENCE -->
    <!-- ============================== -->

    <p>
        Reference:

        <strong>
            <%= transaction.reference %>
        </strong>
    </p>


    <!-- ============================== -->
    <!-- FROM -->
    <!-- ============================== -->

    <p>
        From:

        <strong>

            <% if (transaction.type === "customer_payment") { %>

                External Customer

            <% } else if (transaction.fromShop) { %>

                <%= transaction.fromShop.name %>

            <% } else { %>

                Unknown

            <% } %>

        </strong>
    </p>


    <!-- ============================== -->
    <!-- TO -->
    <!-- ============================== -->

    <p>
        To:

        <strong>

            <% if (transaction.toShop) { %>

                <%= transaction.toShop.name %>

            <% } else { %>

                Unknown Shop

            <% } %>

        </strong>
    </p>


    <!-- ============================== -->
    <!-- PRODUCT -->
    <!-- TRADE PAYMENTS ONLY -->
    <!-- ============================== -->

    <% if (
        transaction.type === "trade_payment" &&
        transaction.tradeRequest
    ) { %>

        <p>
            Product:

            <strong>
                <%= transaction.tradeRequest.product %>
            </strong>
        </p>

    <% } %>


    <!-- ============================== -->
    <!-- AMOUNT -->
    <!-- ============================== -->

    <p>
        Amount:

        <strong>
            R<%= Number(transaction.amount).toFixed(2) %>
        </strong>
    </p>


    <!-- ============================== -->
    <!-- CURRENCY -->
    <!-- ============================== -->

    <p>
        Currency:

        <strong>
            <%= transaction.currency %>
        </strong>
    </p>


    <!-- ============================== -->
    <!-- STATUS -->
    <!-- ============================== -->

    <p>
        Status:

        <strong>
            <%= transaction.status %>
        </strong>
    </p>


    <!-- ============================== -->
    <!-- PAYMENT METHOD -->
    <!-- ============================== -->

    <p>
        Payment Method:

        <strong>

            <% if (
                transaction.type === "customer_payment" ||
                transaction.type === "direct_payment"
            ) { %>

                Open Payments + Interledger

            <% } else if (
                transaction.payment &&
                transaction.payment.method === "open_payments"
            ) { %>

                Open Payments + Interledger

            <% } else if (transaction.payment) { %>

                <%= transaction.payment.method %>

            <% } else { %>

                Unknown

            <% } %>

        </strong>
    </p>


    <!-- ============================== -->
    <!-- OPEN PAYMENTS PROVIDER ID -->
    <!-- ============================== -->

    <% if (transaction.providerTransactionId) { %>

        <p>
            Open Payments Transaction:
        </p>

        <p>
            <small>
                <%= transaction.providerTransactionId %>
            </small>
        </p>

    <% } %>


    <!-- ============================== -->
    <!-- TRADE LINK -->
    <!-- ============================== -->

    <% if (
        transaction.type === "trade_payment" &&
        transaction.tradeRequest
    ) { %>

        <p>

            <a href="/trade/<%= transaction.tradeRequest._id %>">
                View Trade
            </a>

        </p>

    <% } %>


    <!-- ============================== -->
    <!-- DATE -->
    <!-- ============================== -->

    <p>
        Date:

        <strong>
            <%= transaction.createdAt.toLocaleString() %>
        </strong>
    </p>


    <hr>


    <a href="/transactions">
        Back to Transactions
    </a>


</body>

</html>