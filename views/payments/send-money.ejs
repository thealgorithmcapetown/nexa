<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Send Money - NEXA
    </title>

    <link
        rel="stylesheet"
        href="/css/main.css"
    >

</head>

<body>


    <h1>
        Send Money
    </h1>


    <p>
        Send money to another NEXA vendor
        using Open Payments + Interledger.
    </p>


    <p>
        <strong>
            From:
        </strong>

        <%= currentShop.name %>
    </p>


    <p>
        <strong>
            Your wallet:
        </strong>

        <%= currentShop.walletAddress || "No wallet configured" %>
    </p>


    <form
        action="/payments/send"
        method="POST"
    >

        <div>

            <label for="walletAddress">
                Recipient Wallet Address
            </label>

            <br>

            <input
                id="walletAddress"
                type="text"
                name="walletAddress"
                placeholder="https://ilp.interledger-test.dev/vendor"
                required
            >

        </div>


        <br>


        <div>

            <label for="amount">
                Amount
            </label>

            <br>

            <input
                id="amount"
                type="number"
                name="amount"
                min="0.01"
                step="0.01"
                placeholder="100.00"
                required
            >

        </div>


        <br>


        <div>

            <label for="reference">
                Reference
            </label>

            <br>

            <input
                id="reference"
                type="text"
                name="reference"
                maxlength="100"
                placeholder="Stock payment"
                required
            >

        </div>


        <br>


        <button type="submit">
            Send with Open Payments
        </button>

    </form>


    <br>


    <a href="/payments">
        Back to Payments
    </a>


</body>

</html>