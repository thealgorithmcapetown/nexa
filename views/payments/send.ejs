<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Payment - NEXA
    </title>

    <link
        rel="stylesheet"
        href="/css/main.css"
    >

</head>

<body>


    <h1>
        Complete Payment
    </h1>


    <h2>
        Trade
    </h2>


    <p>
        Product:
        <strong>
            <%= offer.tradeRequest.product %>
        </strong>
    </p>


    <p>
        Quantity:
        <%= offer.quantity %>
        <%= offer.tradeRequest.unit %>
    </p>


    <p>
        Seller:
        <strong>
            <%= offer.seller.name %>
        </strong>
    </p>


    <p>
        Amount:
        <strong>
            R<%= offer.amount %>
        </strong>
    </p>


    <p>
        Payment Method:
        NEXA Mock Payment
    </p>


    <form
        action="/payments/offer/<%= offer._id %>"
        method="POST"
    >

        <button type="submit">

            Pay R<%= offer.amount %>

        </button>

    </form>


    <br>


    <a href="/offers/<%= offer._id %>">

        Cancel

    </a>


</body>

</html>