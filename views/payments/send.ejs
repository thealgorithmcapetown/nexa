
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Complete Payment - NEXA</title>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/sidebar.css">
    <link rel="stylesheet" href="/css/navbar.css">
    <link rel="stylesheet" href="/css/trade-payment.css">

    <style>
        .trade-payment-wallet {
            display: flex;
            flex-direction: column;
            gap: 10px;
            padding: 18px;
            margin-top: 18px;
            border: 1px solid rgba(181, 243, 75, 0.25);
            border-radius: 12px;
            background: rgba(181, 243, 75, 0.05);
        }

        .trade-payment-wallet-label {
            color: #a9bdb0;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: 0.08em;
        }

        .trade-payment-wallet-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
        }

        .trade-payment-wallet-address {
            min-width: 0;
            overflow-wrap: anywhere;
            color: #d7f8b5;
            font-size: 13px;
            font-weight: 600;
        }

        .trade-payment-wallet-copy {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            gap: 7px;
            padding: 10px 13px;
            border: 1px solid rgba(181, 243, 75, 0.35);
            border-radius: 9px;
            background: rgba(181, 243, 75, 0.12);
            color: #d7f8b5;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .trade-payment-wallet-copy:hover {
            background: rgba(181, 243, 75, 0.22);
        }

        .trade-payment-wallet-copy svg {
            width: 15px;
            height: 15px;
        }

        .trade-payment-wallet-copy:disabled {
            cursor: default;
            opacity: 0.8;
        }

        .trade-payment-wallet-help {
            margin: 0;
            color: #a9bdb0;
            font-size: 12px;
            line-height: 1.6;
        }

        @media (max-width: 600px) {
            .trade-payment-wallet-content {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>

</head>

<body>

    <%- include('../partials/sidebar') %>
    <%- include('../partials/navbar') %>

    <main class="nexa-main trade-payment-page">

        <a href="/offers/<%= offer._id %>" class="trade-payment-back">

            <i data-lucide="arrow-left"></i>

            Back to Offer

        </a>

        <header class="trade-payment-heading">

            <span class="trade-payment-eyebrow">
                NEXA PAYMENTS
            </span>

            <h1>
                Complete Payment
            </h1>

            <p>
                Review your trade details before confirming payment.
            </p>

        </header>

        <div class="trade-payment-layout">

            <section class="trade-payment-card">

                <div class="trade-payment-card-header">

                    <span class="trade-payment-eyebrow">
                        PAYMENT SUMMARY
                    </span>

                    <h2>
                        Review Your Payment
                    </h2>

                    <p>
                        Make sure everything is correct before proceeding.
                    </p>

                </div>

                <div class="trade-payment-details">

                    <div class="trade-payment-detail-row">

                        <span>
                            Product
                        </span>

                        <strong>
                            <%= offer.tradeRequest.product %>
                        </strong>

                    </div>

                    <div class="trade-payment-detail-row">

                        <span>
                            Quantity
                        </span>

                        <strong>
                            <%= offer.quantity %>
                            <%= offer.tradeRequest.unit %>
                        </strong>

                    </div>

                    <div class="trade-payment-detail-row">

                        <span>
                            Seller
                        </span>

                        <strong>
                            <%= offer.seller.name %>
                        </strong>

                    </div>

                    <div class="trade-payment-detail-row">

                        <span>
                            Payment Method
                        </span>

                        <strong>
                            Open Payments
                        </strong>

                    </div>

                </div>

                <%
                    const rawSellerWallet = String(
                        offer.seller?.walletAddress || ""
                    ).trim();

                    const sellerWallet = rawSellerWallet.startsWith("https://")
                        ? `$${rawSellerWallet.slice(8)}`
                        : rawSellerWallet;
                %>

                <div class="trade-payment-wallet">

                    <span class="trade-payment-wallet-label">
                        SELLER WALLET ADDRESS
                    </span>

                    <div class="trade-payment-wallet-content">

                        <span
                            class="trade-payment-wallet-address"
                            id="sellerWalletAddress"
                        >
                            <%= sellerWallet || "Wallet not available" %>
                        </span>

                        <% if (sellerWallet) { %>

                            <button
                                type="button"
                                class="trade-payment-wallet-copy"
                                id="copySellerWallet"
                                aria-label="Copy seller wallet address"
                            >
                                <i data-lucide="copy"></i>
                                <span>Copy Wallet</span>
                            </button>

                        <% } %>

                    </div>

                    <p class="trade-payment-wallet-help">
                        Copy the seller's wallet address whenever you need it.
                    </p>

                </div>

                <div class="trade-payment-total">

                    <div>

                        <span>
                            TOTAL PAYMENT
                        </span>

                        <strong>
                            R<%= Number(offer.amount).toFixed(2) %>
                        </strong>

                    </div>

                    <i data-lucide="receipt-text"></i>

                </div>

                <form
                    action="/payments/offer/<%= offer._id %>"
                    method="POST"
                    class="trade-payment-form"
                >

                    <button type="submit" class="trade-payment-submit">

                        <i data-lucide="check-circle-2"></i>

                        Pay R<%= Number(offer.amount).toFixed(2) %>

                    </button>

                </form>

                <a href="/offers/<%= offer._id %>" class="trade-payment-cancel">

                    Cancel Payment

                </a>

            </section>

            <aside class="trade-payment-sidebar">

                <section class="trade-payment-info-card">

                    <span class="trade-payment-eyebrow">
                        PAYMENT METHOD
                    </span>

                    <h3>
                        Open Payments
                    </h3>

                    <p>
                        NEXA uses Interledger Open Payments to initiate
                        wallet-to-wallet transactions. Your wallet provider
                        may require you to authorize the payment.
                    </p>

                    <i data-lucide="wallet-cards" class="trade-payment-watermark"></i>

                </section>

                <section class="trade-payment-note-card">

                    <i data-lucide="shield-check"></i>

                    <div>

                        <h3>
                            Check Before Confirming
                        </h3>

                        <p>
                            Verify the seller, wallet address, quantity,
                            and payment amount before proceeding.
                        </p>

                    </div>

                </section>

            </aside>

        </div>

    </main>

    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>

    <script src="/js/navigation.js"></script>

    <script>
        if (window.lucide) {
            lucide.createIcons();
        }

        const copySellerWalletButton =
            document.getElementById("copySellerWallet");

        if (copySellerWalletButton) {

            copySellerWalletButton.addEventListener("click", async () => {

                const walletAddress = document
                    .getElementById("sellerWalletAddress")
                    .textContent
                    .trim();

                try {

                    await navigator.clipboard.writeText(walletAddress);

                    const label = copySellerWalletButton.querySelector("span");

                    label.textContent = "Copied!";

                    setTimeout(() => {
                        label.textContent = "Copy Wallet";
                    }, 2000);

                } catch (error) {

                    console.error("WALLET COPY ERROR:", error);

                    const label = copySellerWalletButton.querySelector("span");

                    label.textContent = "Copy failed";

                    setTimeout(() => {
                        label.textContent = "Copy Wallet";
                    }, 2000);

                }

            });

        }
    </script>

</body>

</html>
