
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
    <meta charset="UTF-8">
    <%- include('../partials/loader') %>
    <link rel="stylesheet" href="/css/loader.css">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Pay with NEXA</title>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/customer-pay.css">

    <style>
        .customer-wallet-warning {
            display: flex;
            align-items: flex-start;
            gap: 13px;
            padding: 17px 18px;
            margin-bottom: 22px;
            border: 1px solid rgba(181, 243, 75, 0.3);
            border-radius: 13px;
            background: rgba(181, 243, 75, 0.07);
        }

        .customer-wallet-warning-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            width: 35px;
            height: 35px;
            border-radius: 10px;
            background: rgba(181, 243, 75, 0.12);
            color: #b5f34b;
        }

        .customer-wallet-warning-icon svg {
            width: 19px;
            height: 19px;
        }

        .customer-wallet-warning-content {
            flex: 1;
            min-width: 0;
        }

        .customer-wallet-warning-content strong {
            display: block;
            margin-bottom: 7px;
            color: #d7f8b5;
            font-size: 14px;
            font-weight: 700;
        }

        .customer-wallet-warning-content p {
            margin: 0;
            color: #a9bdb0;
            font-size: 13px;
            line-height: 1.7;
        }

        .customer-wallet-warning-content p + p {
            margin-top: 8px;
        }

        .customer-wallet-warning-content b {
            color: #d7f8b5;
            font-weight: 600;
        }

        .customer-wallet-copy-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-top: 10px;
        }

        .customer-wallet-copy-address {
            flex: 1;
            min-width: 0;
            margin: 0;
            overflow-wrap: anywhere;
            word-break: break-word;
        }

        .customer-wallet-copy-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            gap: 7px;
            padding: 10px 12px;
            border: 1px solid rgba(181, 243, 75, 0.35);
            border-radius: 9px;
            background: rgba(181, 243, 75, 0.12);
            color: #d7f8b5;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .customer-wallet-copy-button:hover {
            background: rgba(181, 243, 75, 0.22);
        }

        .customer-wallet-copy-button svg {
            width: 15px;
            height: 15px;
        }

        .customer-wallet-copy-button:focus-visible {
            outline: 2px solid #b5f34b;
            outline-offset: 3px;
        }

        .customer-wallet-copy-help {
            margin: 9px 0 0;
            color: #a9bdb0;
            font-size: 12px;
            line-height: 1.6;
        }

        .customer-wallet-paste-button {
            margin-top: 10px;
        }

        .customer-wallet-actions {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 10px;
        }

        .customer-wallet-actions .customer-wallet-paste-button {
            margin-top: 0;
        }

        .customer-saved-wallet {
            display: none;
            margin-top: 16px;
            padding: 15px;
            border: 1px solid rgba(181, 243, 75, 0.3);
            border-radius: 12px;
            background: rgba(181, 243, 75, 0.07);
        }

        .customer-saved-wallet.is-visible {
            display: block;
        }

        .customer-saved-wallet-title {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #d7f8b5;
            font-size: 13px;
            font-weight: 700;
        }

        .customer-saved-wallet-title svg {
            width: 17px;
            height: 17px;
        }

        .customer-saved-wallet-address {
            margin: 10px 0 13px;
            color: #d7f8b5;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .customer-saved-wallet-actions {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }

        .customer-wallet-status {
            margin: 10px 0 0;
            color: #d7f8b5;
            font-size: 12px;
            line-height: 1.5;
        }

        .customer-wallet-status:empty {
            display: none;
        }

        @media (max-width: 600px) {
            .customer-wallet-warning {
                padding: 14px;
                gap: 10px;
            }

            .customer-wallet-copy-row {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>

</head>

<body class="customer-pay-body">

    <main class="customer-pay-page">

        <header class="customer-pay-header">

            <a href="/" class="customer-pay-brand" aria-label="NEXA home">

                <img
                    src="/images/branding/nexa-logo2.svg"
                    alt="NEXA"
                    class="customer-pay-logo"
                >

            </a>

            <div class="customer-pay-header-label">

                <i data-lucide="shield-check"></i>

                Payment Checkout

            </div>

        </header>

        <div class="customer-pay-heading">

            <span class="customer-pay-eyebrow">
                NEXA PAYMENTS
            </span>

            <h1>
                Complete Your Payment<span class="nexa-title-dot">.</span>
            </h1>

            <p>
                Review the payment request and use your Open Payments
                wallet address to continue.
            </p>

        </div>

        <div class="customer-pay-layout">

            <section class="customer-pay-summary-card">

                <span class="customer-pay-eyebrow">
                    PAYMENT SUMMARY
                </span>

                <p class="customer-pay-amount-label">
                    Amount to pay
                </p>

                <h2 class="customer-pay-amount">
                    R<%= Number(paymentRequest.amount).toFixed(2) %>
                </h2>

                <div class="customer-pay-details">

                    <div class="customer-pay-detail-row">

                        <span>
                            Paying to
                        </span>

                        <strong>
                            <%= paymentRequest.shop.name %>
                        </strong>

                    </div>

                    <div class="customer-pay-detail-row">

                        <span>
                            Reference
                        </span>

                        <strong>
                            <%= paymentRequest.reference %>
                        </strong>

                    </div>

                    <div class="customer-pay-detail-row">

                        <span>
                            Currency
                        </span>

                        <strong>
                            <%= paymentRequest.currency %>
                        </strong>

                    </div>

                </div>

                <%
                    const rawRecipientWallet = String(
                        paymentRequest.walletAddress || ""
                    ).trim();

                    const recipientWallet = rawRecipientWallet.startsWith("https://")
                        ? `$${rawRecipientWallet.slice(8)}`
                        : rawRecipientWallet;
                %>

                <div class="customer-pay-recipient">

                    <span>
                        RECEIVING WALLET
                    </span>

                    <div class="customer-wallet-copy-row">

                        <p class="customer-wallet-copy-address">
                            <%= recipientWallet || "Wallet not available" %>
                        </p>

                    </div>

                    <p class="customer-wallet-copy-help">
                        This is the shop's receiving wallet.
                        Your own wallet is entered below.
                    </p>

                </div>

                <i data-lucide="wallet-cards" class="customer-pay-watermark"></i>

            </section>

            <section class="customer-pay-form-card">

                <div class="customer-pay-form-heading">

                    <span class="customer-pay-eyebrow">
                        PAYMENT METHOD
                    </span>

                    <h2>
                        Pay with Open Payments
                    </h2>

                    <p>
                        Use your wallet address to proceed with
                        payment authorization.
                    </p>

                </div>

                <div class="customer-wallet-warning" role="note">

                    <div class="customer-wallet-warning-icon">
                        <i data-lucide="shield-alert"></i>
                    </div>

                    <div class="customer-wallet-warning-content">

                        <strong>
                            Before you continue
                        </strong>

                        <p>
                            You need a compatible
                            <b>Open Payments wallet</b>
                            to complete this transaction.
                            Make sure you are signed in to your
                            wallet provider before continuing.
                        </p>

                        <p>
                            Your wallet provider may ask you to
                            sign in again and approve the payment
                            during authorization.
                        </p>

                    </div>

                </div>

                <form
                    action="/pay/<%= paymentRequest._id %>/open-payments"
                    method="POST"
                    class="customer-pay-form"
                    id="customerOpenPaymentsForm"
                >

                    <div class="customer-pay-field">

                        <label for="payerWalletAddress">
                            Your Open Payments Wallet Address
                            <span>*</span>
                        </label>

                        <div class="customer-pay-input-wrap">

                            <i data-lucide="wallet"></i>

                            <input
                                type="text"
                                id="payerWalletAddress"
                                name="payerWalletAddress"
                                placeholder="$ilp.interledger-test.dev/yourname"
                                autocomplete="off"
                                autocapitalize="none"
                                spellcheck="false"
                                required
                            >

                        </div>

                        <div class="customer-wallet-actions">

                            <button
                                type="button"
                                class="customer-wallet-copy-button"
                                id="pastePayerWallet"
                            >
                                <i data-lucide="clipboard-paste"></i>
                                <span>Paste Wallet Address</span>
                            </button>

                            <button
                                type="button"
                                class="customer-wallet-copy-button"
                                id="copyPayerWallet"
                            >
                                <i data-lucide="copy"></i>
                                <span>Copy My Wallet</span>
                            </button>

                        </div>

                        <div
                            class="customer-saved-wallet"
                            id="savedWalletPanel"
                        >

                            <div class="customer-saved-wallet-title">
                                <i data-lucide="check-circle-2"></i>
                                Saved Wallet
                            </div>

                            <p
                                class="customer-saved-wallet-address"
                                id="savedWalletAddress"
                            ></p>

                            <div class="customer-saved-wallet-actions">

                                <button
                                    type="button"
                                    class="customer-wallet-copy-button"
                                    id="useSavedWallet"
                                >
                                    <i data-lucide="wallet"></i>
                                    <span>Use Saved Wallet</span>
                                </button>

                                <button
                                    type="button"
                                    class="customer-wallet-copy-button"
                                    id="forgetSavedWallet"
                                >
                                    <i data-lucide="trash-2"></i>
                                    <span>Forget Wallet</span>
                                </button>

                            </div>

                        </div>

                        <p
                            class="customer-wallet-status"
                            id="walletStatus"
                            role="status"
                            aria-live="polite"
                        ></p>

                        <p class="customer-pay-field-help">
                            Enter your own wallet address once.
                            NEXA can remember it on this device for
                            future payments. You can change it anytime.
                        </p>

                    </div>

                    <div class="customer-pay-notice">

                        <i data-lucide="info"></i>

                        <p>
                            Continuing will start the Open Payments
                            authorization process. It does not
                            confirm that payment has been completed.
                        </p>

                    </div>

                    <button
                        type="submit"
                        class="customer-pay-submit"
                    >

                        Continue with Open Payments

                        <i data-lucide="arrow-right"></i>

                    </button>

                </form>

            </section>

        </div>

        <footer class="customer-pay-footer">

            <span>

                <i data-lucide="shield-check"></i>

                Verify the merchant and amount before authorizing payment.

            </span>

            <p>
                Powered by <strong>NEXA</strong>
            </p>

        </footer>

    </main>

    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>

    <script>
        if (window.lucide) {
            lucide.createIcons();
        }

        const walletStorageKey = "nexa_customer_wallet_address";

        const customerPaymentForm =
            document.getElementById("customerOpenPaymentsForm");

        const payerWalletInput =
            document.getElementById("payerWalletAddress");

        const pastePayerWalletButton =
            document.getElementById("pastePayerWallet");

        const copyPayerWalletButton =
            document.getElementById("copyPayerWallet");

        const savedWalletPanel =
            document.getElementById("savedWalletPanel");

        const savedWalletAddress =
            document.getElementById("savedWalletAddress");

        const useSavedWalletButton =
            document.getElementById("useSavedWallet");

        const forgetSavedWalletButton =
            document.getElementById("forgetSavedWallet");

        const walletStatus =
            document.getElementById("walletStatus");

        const normalizeWalletAddress = (value) => {

            const trimmed = String(value || "").trim();

            if (!trimmed) {
                return "";
            }

            if (trimmed.startsWith("https://")) {
                return `$${trimmed.slice(8)}`;
            }

            return trimmed;

        };

        const isValidWalletAddress = (value) => {

            const walletAddress = String(value || "").trim();

            if (!walletAddress || /\s/.test(walletAddress)) {
                return false;
            }

            try {

                const normalized = walletAddress.startsWith("$")
                    ? `https://${walletAddress.slice(1)}`
                    : walletAddress;

                const url = new URL(normalized);

                return (
                    url.protocol === "https:" &&
                    Boolean(url.hostname) &&
                    !url.username &&
                    !url.password &&
                    !url.hash
                );

            } catch (error) {
                return false;
            }

        };

        const getSavedWallet = () => {

            try {

                const value = localStorage.getItem(walletStorageKey);

                return isValidWalletAddress(value)
                    ? normalizeWalletAddress(value)
                    : "";

            } catch (error) {
                return "";
            }

        };

        const saveWallet = (walletAddress) => {

            try {

                localStorage.setItem(
                    walletStorageKey,
                    normalizeWalletAddress(walletAddress)
                );

                return true;

            } catch (error) {
                return false;
            }

        };

        const removeSavedWallet = () => {

            try {

                localStorage.removeItem(walletStorageKey);

                return true;

            } catch (error) {
                return false;
            }

        };

        const showWalletStatus = (message) => {
            walletStatus.textContent = message;
        };

        const refreshSavedWallet = () => {

            const walletAddress = getSavedWallet();

            if (walletAddress) {

                savedWalletAddress.textContent = walletAddress;

                savedWalletPanel.classList.add("is-visible");

            } else {

                savedWalletAddress.textContent = "";

                savedWalletPanel.classList.remove("is-visible");

            }

        };

        const initialSavedWallet = getSavedWallet();

        if (initialSavedWallet) {

            payerWalletInput.value = initialSavedWallet;

            showWalletStatus(
                "Your saved wallet has been filled in automatically."
            );

        }

        refreshSavedWallet();

        payerWalletInput.addEventListener("input", () => {

            payerWalletInput.setCustomValidity("");

            showWalletStatus("");

        });

        pastePayerWalletButton.addEventListener("click", async () => {

            const label = pastePayerWalletButton.querySelector("span");

            try {

                const clipboardValue =
                    await navigator.clipboard.readText();

                const walletAddress =
                    normalizeWalletAddress(clipboardValue);

                if (!isValidWalletAddress(walletAddress)) {

                    showWalletStatus(
                        "Your clipboard does not contain a valid wallet address."
                    );

                    return;

                }

                payerWalletInput.value = walletAddress;

                payerWalletInput.setCustomValidity("");

                label.textContent = "Wallet Pasted!";

                showWalletStatus(
                    "Wallet address pasted. Check it before continuing."
                );

                setTimeout(() => {
                    label.textContent = "Paste Wallet Address";
                }, 2000);

            } catch (error) {

                console.error("WALLET PASTE ERROR:", error);

                label.textContent = "Paste manually";

                payerWalletInput.focus();

                showWalletStatus(
                    "Clipboard access is unavailable. Paste directly into the field."
                );

                setTimeout(() => {
                    label.textContent = "Paste Wallet Address";
                }, 2000);

            }

        });

        copyPayerWalletButton.addEventListener("click", async () => {

            const walletAddress =
                normalizeWalletAddress(payerWalletInput.value);

            if (!isValidWalletAddress(walletAddress)) {

                showWalletStatus(
                    "Enter your own valid wallet address before copying."
                );

                payerWalletInput.focus();

                return;

            }

            const label = copyPayerWalletButton.querySelector("span");

            try {

                await navigator.clipboard.writeText(walletAddress);

                label.textContent = "Copied!";

                setTimeout(() => {
                    label.textContent = "Copy My Wallet";
                }, 2000);

            } catch (error) {

                console.error("WALLET COPY ERROR:", error);

                showWalletStatus(
                    "Unable to copy automatically. Select and copy the address manually."
                );

            }

        });

        useSavedWalletButton.addEventListener("click", () => {

            const walletAddress = getSavedWallet();

            if (!walletAddress) {
                return;
            }

            payerWalletInput.value = walletAddress;

            payerWalletInput.setCustomValidity("");

            showWalletStatus("Saved wallet selected.");

        });

        forgetSavedWalletButton.addEventListener("click", () => {

            const previousSavedWallet = getSavedWallet();

            if (!removeSavedWallet()) {

                showWalletStatus(
                    "Unable to remove the saved wallet on this device."
                );

                return;

            }

            if (
                normalizeWalletAddress(payerWalletInput.value) ===
                previousSavedWallet
            ) {
                payerWalletInput.value = "";
            }

            refreshSavedWallet();

            showWalletStatus(
                "Saved wallet forgotten. Enter a wallet to continue."
            );

        });

        customerPaymentForm.addEventListener("submit", (event) => {

            const walletAddress =
                normalizeWalletAddress(payerWalletInput.value);

            payerWalletInput.setCustomValidity("");

            if (!isValidWalletAddress(walletAddress)) {

                event.preventDefault();

                payerWalletInput.setCustomValidity(
                    "Enter a valid Interledger wallet address, for example $ilp.interledger-test.dev/yourname"
                );

                payerWalletInput.reportValidity();

                return;

            }

            payerWalletInput.value = walletAddress;

            const saved = saveWallet(walletAddress);

            if (!saved) {

                showWalletStatus(
                    "This browser could not remember your wallet, but you can still continue."
                );

            }

        });
    </script>

    <script src="/js/loader.js"></script>

</body>

</html>
