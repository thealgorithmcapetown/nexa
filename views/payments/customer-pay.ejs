<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Pay with NEXA
    </title>

    <link
        rel="stylesheet"
        href="/css/main.css"
    >

</head>

<body>


    <h1>
        NEXA Payment
    </h1>


    <p>
        Pay
    </p>


    <h2>
        R<%= paymentRequest.amount %>
    </h2>


    <p>
        To:
        <strong>
            <%= paymentRequest.shop.name %>
        </strong>
    </p>


    <p>
        Reference:
        <strong>
            <%= paymentRequest.reference %>
        </strong>
    </p>


    <p>
        Currency:
        <%= paymentRequest.currency %>
    </p>


    <hr>


    <p>
        Recipient wallet:
    </p>

    <p>
        <%= paymentRequest.walletAddress %>
    </p>


    <button
        type="button"
        disabled
    >
        Continue with Open Payments
    </button>


    <p>
        Open Payments authorization
        will be connected next.
    </p>


</body>

</html>