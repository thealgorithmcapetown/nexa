<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Payment Request - NEXA
    </title>

    <link
        rel="stylesheet"
        href="/css/main.css"
    >

</head>

<body>


    <h1>
        Payment Request
    </h1>


    <p>
        Customer pays:
    </p>


    <h2>
        R<%= Number(paymentRequest.amount).toFixed(2) %>
    </h2>


    <p>
        To:
        <strong>
            <%= paymentRequest.shop.name %>
        </strong>
    </p>


    <p>
        Reference:
        <strong>
            <%= paymentRequest.reference %>
        </strong>
    </p>


    <!-- ============================== -->
    <!-- LIVE PAYMENT STATUS -->
    <!-- ============================== -->

    <div id="payment-status">

        <% if (paymentRequest.status === "paid") { %>

            <h2>
                ✓ PAYMENT RECEIVED
            </h2>

            <p>
                R<%= Number(paymentRequest.amount).toFixed(2) %>
            </p>

        <% } else { %>

            <p>
                Status:
                <strong>
                    Waiting for payment...
                </strong>
            </p>

            <p>
                Keep this page open.
            </p>

        <% } %>

    </div>


    <h2>
        Scan to Pay
    </h2>


    <img
        src="<%= qrCode %>"
        alt="NEXA payment QR code"
        width="280"
    >


    <p>
        Payment URL:
    </p>


    <p>
        <%= paymentUrl %>
    </p>


    <br>


    <a href="/payments/receive">
        Create Another Payment Request
    </a>


    <!-- ============================== -->
    <!-- LIVE PAYMENT CHECKER -->
    <!-- ============================== -->

    <script>

        const paymentRequestId =
            "<%= paymentRequest._id %>";


        let paymentFound =
            <%= paymentRequest.status === "paid"
                ? "true"
                : "false"
            %>;


        async function checkPaymentStatus() {

            if (paymentFound) {

                return;

            }


            try {

                const response =
                    await fetch(
                        `/payments/requests/${paymentRequestId}/status`
                    );


                if (!response.ok) {

                    console.error(
                        "Unable to check payment status"
                    );

                    return;

                }


                const data =
                    await response.json();


                console.log(
                    "PAYMENT STATUS:",
                    data.status
                );


                if (data.status === "paid") {

                    paymentFound =
                        true;


                    const statusBox =
                        document.getElementById(
                            "payment-status"
                        );


                    statusBox.innerHTML = `

                        <h2>
                            ✓ PAYMENT RECEIVED
                        </h2>

                        <p>
                            R${Number(data.amount).toFixed(2)}
                        </p>

                        ${
                            data.transactionId
                                ? `
                                    <a
                                        href="/transactions/${data.transactionId}"
                                    >
                                        View Receipt
                                    </a>
                                `
                                : ""
                        }

                    `;


                    clearInterval(
                        paymentChecker
                    );

                }


            } catch (error) {

                console.error(
                    "PAYMENT STATUS CHECK ERROR:",
                    error
                );

            }

        }


        const paymentChecker =
            setInterval(
                checkPaymentStatus,
                2000
            );


        checkPaymentStatus();

    </script>


</body>

</html>