
<!DOCTYPE html>
<html lang="en">

<head>
    <%- include('../partials/head') %>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Payment Successful - NEXA</title>

    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/customer-success.css">

    <style>
        .nexa-payment-celebration {
            position: fixed;
            inset: 0;
            z-index: 99999;
            width: 100%;
            height: 100vh;
            height: 100dvh;
            background: #8CE11A;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 1;
            visibility: visible;
            transition:
                opacity 0.3s ease,
                visibility 0.3s ease;
        }

        .nexa-payment-celebration.fade-out {
            opacity: 0;
            visibility: hidden;
            pointer-events: none;
        }

        .nexa-celebration-content {
            width: 100%;
            padding: 24px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        .nexa-celebration-stage {
            width: 100%;
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
        }

        .nexa-celebration-message,
        .nexa-celebration-brand {
            opacity: 0;
            transform: translateY(35px) scale(0.96);
            filter: blur(8px);
            transition:
                opacity 0.25s ease,
                transform 0.25s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.25s ease;
        }

        .nexa-celebration-message.visible,
        .nexa-celebration-brand.visible {
            opacity: 1;
            transform: translateY(0) scale(1);
            filter: blur(0);
        }

        .nexa-celebration-message {
            color: #071A10;
            font-family: Arial, Helvetica, sans-serif;
            font-size: clamp(48px, 10vw, 100px);
            font-weight: 800;
            letter-spacing: -0.055em;
            line-height: 1.15;
            text-align: center;
        }

        .nexa-celebration-brand {
            display: none;
            align-items: center;
            justify-content: center;
            gap: clamp(14px, 3vw, 28px);
            max-width: 100%;
        }

        .nexa-celebration-brand.active {
            display: flex;
        }

        .nexa-celebration-brand-text {
            width: clamp(155px, 30vw, 300px);
            max-height: 90px;
            object-fit: contain;
        }

        .nexa-celebration-divider {
            width: 2px;
            height: clamp(42px, 6vw, 65px);
            background: #071A10;
            border-radius: 2px;
            flex-shrink: 0;
        }

        .nexa-celebration-brand-icon {
            width: clamp(48px, 8vw, 78px);
            height: clamp(48px, 8vw, 78px);
            object-fit: contain;
        }

        .nexa-celebration-loading-track {
            margin-top: 35px;
            width: 180px;
            height: 3px;
            background: rgba(7, 26, 16, 0.18);
            border-radius: 10px;
            overflow: hidden;
        }

        .nexa-celebration-loading-bar {
            width: 35%;
            height: 100%;
            background: #071A10;
            border-radius: 10px;
            animation: nexaCelebrationLoading 1.4s ease-in-out infinite;
        }

        @keyframes nexaCelebrationLoading {
            0% {
                transform: translateX(-110%);
            }

            100% {
                transform: translateX(400%);
            }
        }

        @media (max-width: 600px) {
            .nexa-celebration-stage {
                min-height: 100px;
            }

            .nexa-celebration-message {
                font-size: clamp(38px, 11vw, 60px);
            }

            .nexa-celebration-brand {
                gap: 12px;
            }

            .nexa-celebration-brand-text {
                width: clamp(130px, 42vw, 180px);
            }

            .nexa-celebration-divider {
                height: 42px;
            }

            .nexa-celebration-brand-icon {
                width: 48px;
                height: 48px;
            }

            .nexa-celebration-loading-track {
                width: 150px;
                margin-top: 25px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            .nexa-celebration-message,
            .nexa-celebration-brand {
                transform: none;
                filter: none;
            }

            .nexa-celebration-loading-bar {
                animation: none;
                width: 100%;
            }
        }
    </style>

</head>

<body class="customer-success-body">

    <div
        class="nexa-payment-celebration"
        id="paymentCelebration"
        role="status"
        aria-live="polite"
    >

        <div class="nexa-celebration-content">

            <div class="nexa-celebration-stage">

                <h1
                    class="nexa-celebration-message"
                    id="paymentCelebrationMessage"
                >
                    Payment sent.
                </h1>

                <div
                    class="nexa-celebration-brand"
                    id="paymentCelebrationBrand"
                    aria-label="NEXA"
                >

                    <img
                        src="/images/branding/nexa-logo2black.svg"
                        alt="NEXA"
                        class="nexa-celebration-brand-text"
                    >

                    <span
                        class="nexa-celebration-divider"
                        aria-hidden="true"
                    ></span>

                    <img
                        src="/images/branding/nexa-loading-icon.png"
                        alt=""
                        class="nexa-celebration-brand-icon"
                    >

                </div>

            </div>

            <div class="nexa-celebration-loading-track">
                <div class="nexa-celebration-loading-bar"></div>
            </div>

        </div>

    </div>

    <main class="customer-success-page">

        <header class="customer-success-header">

            <a
                href="/"
                class="customer-success-brand"
                aria-label="NEXA home"
            >

                <img
                    src="/images/branding/nexa-logo2.svg"
                    alt="NEXA"
                    class="customer-success-logo"
                >

            </a>

            <div class="customer-success-header-label">

                <i data-lucide="shield-check"></i>

                Payment Confirmation

            </div>

        </header>

        <section class="customer-success-card">

            <div class="customer-success-icon-wrap">

                <i data-lucide="check"></i>

            </div>

            <span class="customer-success-eyebrow">
                PAYMENT CONFIRMATION
            </span>

            <h1>
                Payment Successful<span class="nexa-title-dot">.</span>
            </h1>

            <p class="customer-success-description">
                Your payment has been recorded as completed.
            </p>

            <div class="customer-success-amount-section">

                <span>
                    AMOUNT PAID
                </span>

                <h2>
                    R<%= Number(paymentRequest.amount).toFixed(2) %>
                </h2>

            </div>

            <div class="customer-success-details">

                <% if (paymentRequest.shop) { %>

                    <div class="customer-success-detail-row">

                        <span>
                            Paid to
                        </span>

                        <strong>
                            <%= paymentRequest.shop.name %>
                        </strong>

                    </div>

                <% } %>

                <% if (paymentRequest.reference) { %>

                    <div class="customer-success-detail-row">

                        <span>
                            Reference
                        </span>

                        <strong>
                            <%= paymentRequest.reference %>
                        </strong>

                    </div>

                <% } %>

                <div class="customer-success-detail-row">

                    <span>
                        Payment status
                    </span>

                    <span class="customer-success-status">

                        <i data-lucide="check-circle-2"></i>

                        PAID

                    </span>

                </div>

            </div>

            <div class="customer-success-network">

                <i data-lucide="network"></i>

                <p>
                    Payment completed through
                    <strong>Open Payments + Interledger</strong>.
                </p>

            </div>

            <a
                href="/"
                class="customer-success-home-button"
            >

                <i data-lucide="arrow-left"></i>

                Back to NEXA

            </a>

        </section>

        <footer class="customer-success-footer">

            <i data-lucide="shield-check"></i>

            <span>
                Powered by NEXA
            </span>

        </footer>

    </main>

    <script src="https://unpkg.com/lucide@0.468.0/dist/umd/lucide.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {

            if (window.lucide) {
                lucide.createIcons();
            }

            const celebration =
                document.getElementById("paymentCelebration");

            const message =
                document.getElementById("paymentCelebrationMessage");

            const brand =
                document.getElementById("paymentCelebrationBrand");

            requestAnimationFrame(() => {

                requestAnimationFrame(() => {
                    message.classList.add("visible");
                });

            });

            setTimeout(() => {

                message.classList.remove("visible");

            }, 1000);

            setTimeout(() => {

                message.style.display = "none";

                brand.classList.add("active");

                requestAnimationFrame(() => {

                    requestAnimationFrame(() => {
                        brand.classList.add("visible");
                    });

                });

            }, 1250);

            setTimeout(() => {

                celebration.classList.add("fade-out");

            }, 1700);

            setTimeout(() => {

                celebration.remove();

            }, 2000);

        });
    </script>

</body>

</html>
