<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>
        Payments - NEXA
    </title>

    <link rel="stylesheet" href="/css/main.css">

</head>

<body>


    <h1>
        Payments
    </h1>


    <section>

        <h2>
            Payment Actions
        </h2>


        <a href="/payments/send">
            Send Money
        </a>

        <br><br>

        <a href="/payments/receive">
            Receive Money
        </a>

    </section>


    <hr>


    <section>

        <h2>
            Recent Transactions
        </h2>


        <% if (recentTransactions.length===0) { %>

            <p>
                No transactions yet.
            </p>

            <% } %>


                <% recentTransactions.forEach(transaction=> { %>

                    <% // Customer QR payments do not have a fromShop. // Trade payments do. const
                        isCustomerPayment=transaction.type==="customer_payment" ; const sent=!isCustomerPayment &&
                        transaction.fromShop && transaction.fromShop._id.toString()===currentShopId.toString(); %>


                        <div>

                            <strong>

                                <% if (isCustomerPayment) { %>

                                    Received

                                    <% } else { %>

                                        <%= sent ? "Sent" : "Received" %>

                                            <% } %>

                            </strong>


                            <p>

                                <% if (isCustomerPayment) { %>

                                    Customer Payment

                                    <% } else { %>

                                        <%= transaction.tradeRequest ? transaction.tradeRequest.product
                                            : "Trade Payment" %>

                                            <% } %>

                            </p>


                            <p>

                                <% if (isCustomerPayment) { %>

                                    From:
                                    Customer

                                    <% } else if (sent) { %>

                                        To:

                                        <%= transaction.toShop ? transaction.toShop.name : "Unknown Shop" %>

                                            <% } else { %>

                                                From:

                                                <%= transaction.fromShop ? transaction.fromShop.name : "Unknown Shop" %>

                                                    <% } %>

                            </p>


                            <p>

                                R<%= Number(transaction.amount).toFixed(2) %>

                            </p>


                            <% if (transaction.reference) { %>

                                <p>

                                    Reference:
                                    <%= transaction.reference %>

                                </p>

                                <% } %>


                                    <a href="/transactions/<%= transaction._id %>">

                                        View Receipt

                                    </a>

                        </div>

                        <hr>

                        <% }) %>

                            <a href="/transactions">
                                View All Transactions
                            </a>

    </section>


    <br>


    <a href="/dashboard">
        Back to Dashboard
    </a>


</body>

</html>