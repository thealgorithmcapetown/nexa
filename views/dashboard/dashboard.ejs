<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>NEXA Dashboard</title>

    <link rel="stylesheet" href="/css/main.css">

</head>

<body>


    <!-- ================================= -->
    <!-- HEADER -->
    <!-- ================================= -->

    <h1>
        NEXA Dashboard
    </h1>


    <h2>
        Welcome, <%= user.name %> 👋
    </h2>


    <h3>
        <%= shop.name %>
    </h3>


    <p>
        <%= shop.category || "Shop" %>
    </p>


    <p>
        📍 <%= shop.address %>
    </p>


    <hr>


    <!-- ================================= -->
    <!-- QUICK ACTIONS -->
    <!-- ================================= -->

    <h2>
        Quick Actions
    </h2>


    <a href="/trade/create">
        Create Trade Request
    </a>

    <br><br>


    <a href="/trade">
        Browse Trade Board
    </a>

    <br><br>


    <a href="/trade/my-requests">
        My Requests
    </a>

    <br><br>


    <a href="/payments/receive">
        Receive Payment
    </a>


    <hr>


    <!-- ================================= -->
    <!-- ACTIVITY -->
    <!-- ================================= -->

    <h2>
        Activity
    </h2>


    <p>

        Active Trades:

        <strong>
            <%= activeTrades %>
        </strong>

    </p>


    <p>

        Pending Offers:

        <strong>
            <%= pendingOffers %>
        </strong>

    </p>


    <p>

        Unread Messages:

        <strong>
            <%= unreadMessages %>
        </strong>

    </p>


    <p>

        Notifications:

        <strong>
            <%= unreadNotifications %>
        </strong>

    </p>


    <hr>


    <!-- ================================= -->
    <!-- MONEY -->
    <!-- ================================= -->

    <h2>
        Payment Summary
    </h2>


    <p>

        Total Received:

        <strong>
            R<%= Number(totalReceived).toFixed(2) %>
        </strong>

    </p>


    <p>

        Total Sent:

        <strong>
            R<%= Number(totalSent).toFixed(2) %>
        </strong>

    </p>


    <hr>


    <!-- ================================= -->
    <!-- RECENT TRANSACTIONS -->
    <!-- ================================= -->

    <h2>
        Recent Transactions
    </h2>


    <% if (recentTransactions.length===0) { %>

        <p>
            No transactions yet.
        </p>

        <% } %>


            <% recentTransactions.forEach(transaction=> { %>

                <div>


                    <p>

                        <strong>

                            <% if ( transaction.fromShop && transaction.fromShop._id.toString()===shop._id.toString() )
                                { %>

                                Payment Sent

                                <% } else { %>

                                    Payment Received

                                    <% } %>

                        </strong>

                    </p>


                    <% if (transaction.tradeRequest) { %>

                        <p>
                            <%= transaction.tradeRequest.product %>
                        </p>

                        <% } else if ( transaction.type==="customer_payment" ) { %>

                            <p>
                                Customer Payment
                            </p>

                            <% } %>


                                <p>

                                    R<%= Number(transaction.amount).toFixed(2) %>

                                </p>


                                <p>

                                    <%= transaction.createdAt.toLocaleString() %>

                                </p>


                                <a href="/transactions/<%= transaction._id %>">
                                    View Receipt
                                </a>


                </div>


                <hr>

                <% }) %>


                    <!-- ================================= -->
                    <!-- NAVIGATION -->
                    <!-- ================================= -->

                    <h2>
                        Navigation
                    </h2>


                    <nav>


                        <a href="/trade">
                            Trade
                        </a>


                        <br><br>


                        <a href="/offers">
                            Offers
                        </a>


                        <br><br>


                        <a href="/messages">

                            Messages

                            <span id="message-count" style="display: none;"></span>

                        </a>


                        <br><br>


                        <a href="/payments">
                            Payments
                        </a>


                        <br><br>


                        <a href="/transactions">
                            Transactions
                        </a>


                        <br><br>


                        <a href="/notifications">

                            Notifications

                            <span id="notification-count" style="display: none;"></span>

                        </a>


                        <br><br>


                        <a href="/shop">
                            My Shop
                        </a>


                        <br><br>
                        <a href="/settings">
                            Settings
                        </a>

                        <br><br>


                        <a href="/logout">
                            Logout
                        </a>


                    </nav>


                    <!-- ================================= -->
                    <!-- SOCKET DATA -->
                    <!-- ================================= -->

                    <script>

                        window.dashboardData = {

                            currentShopId:
                                "<%= shop._id %>"

                        };

                    </script>


                    <script src="/socket.io/socket.io.js"></script>

                    <script src="/js/notifications.js"></script>

                    <script src="/js/messages.js"></script>


</body>

</html>