<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>NEXA Dashboard</title>

    <link
        rel="stylesheet"
        href="/css/main.css"
    >

</head>

<body>


    <h1>
        NEXA Dashboard
    </h1>


    <h2>
        Welcome, <%= user.name %> 👋
    </h2>


    <h3>
        <%= shop.name %>
    </h3>


    <p>
        <%= shop.category || "Shop" %>
    </p>


    <p>
        📍 <%= shop.address %>
    </p>


    <hr>


    <!-- ============================== -->
    <!-- NAVIGATION -->
    <!-- ============================== -->

    <nav>

        <a href="/trade">
            Trade
        </a>

        <a href="/trade/my-requests">
            My Requests
        </a>

        <a href="/offers">
            Offers

            <% if (pendingOffers > 0) { %>

                (<%= pendingOffers %>)

            <% } %>

        </a>


        <a href="/messages">

            Messages

            <span
                id="message-count"
                <%= unreadMessages === 0
                    ? 'style="display: none;"'
                    : ''
                %>
            >
                <%= unreadMessages > 0
                    ? unreadMessages
                    : ""
                %>
            </span>

        </a>


        <a href="/payments">
            Payments
        </a>


        <a href="/transactions">
            Transactions
        </a>


        <a href="/notifications">

            Notifications

            <span
                id="notification-count"
                <%= unreadNotifications === 0
                    ? 'style="display: none;"'
                    : ''
                %>
            >
                <%= unreadNotifications > 0
                    ? unreadNotifications
                    : ""
                %>
            </span>

        </a>


        <a href="/shop">
            My Shop
        </a>


        <a href="/logout">
            Logout
        </a>

    </nav>


    <hr>


    <!-- ============================== -->
    <!-- QUICK ACTIONS -->
    <!-- ============================== -->

    <h2>
        Quick Actions
    </h2>


    <a href="/trade/create">
        Create Trade Request
    </a>

    <br>

    <a href="/trade">
        Browse Trade Requests
    </a>

    <br>

    <a href="/payments/send">
        Send Money
    </a>

    <br>

    <a href="/payments/receive">
        Receive Money
    </a>


    <hr>


    <!-- ============================== -->
    <!-- TRADE ACTIVITY -->
    <!-- ============================== -->

    <h2>
        Trade Activity
    </h2>


    <% if (activeTrades.length === 0) { %>

        <p>
            No active trade requests.
        </p>

    <% } %>


    <% activeTrades.forEach(trade => { %>

        <div>

            <strong>
                <%= trade.product %>
            </strong>


            <p>
                <%= trade.quantity %>
                ×
                <%= trade.unit %>
            </p>


            <p>
                Budget:
                R<%= Number(trade.budget).toFixed(2) %>
            </p>


            <p>
                Status:

                <strong>
                    <%= trade.status.toUpperCase() %>
                </strong>

            </p>


            <a href="/trade/<%= trade._id %>">
                View Trade
            </a>

        </div>

        <hr>

    <% }) %>


    <a href="/trade/my-requests">
        View All My Requests
    </a>


    <hr>


    <!-- ============================== -->
    <!-- RECENT TRANSACTIONS -->
    <!-- ============================== -->

    <h2>
        Recent Transactions
    </h2>


    <% if (recentTransactions.length === 0) { %>

        <p>
            No transactions yet.
        </p>

    <% } %>


    <% recentTransactions.forEach(transaction => { %>

        <%

            const isCustomerPayment =
                transaction.type ===
                "customer_payment";


            const sent =
                !isCustomerPayment &&
                transaction.fromShop &&
                transaction.fromShop._id
                    .toString() ===
                shop._id.toString();

        %>


        <div>


            <strong>

                <% if (isCustomerPayment) { %>

                    Payment Received

                <% } else { %>

                    <%= sent
                        ? "Payment Sent"
                        : "Payment Received"
                    %>

                <% } %>

            </strong>


            <% if (transaction.tradeRequest) { %>

                <p>
                    <%= transaction.tradeRequest.product %>
                </p>

            <% } else if (isCustomerPayment) { %>

                <p>
                    Customer Payment
                </p>

            <% } %>


            <p>

                <% if (isCustomerPayment) { %>

                    From:
                    External Customer

                <% } else if (sent) { %>

                    To:
                    <%= transaction.toShop
                        ? transaction.toShop.name
                        : "Unknown Shop"
                    %>

                <% } else { %>

                    From:
                    <%= transaction.fromShop
                        ? transaction.fromShop.name
                        : "Unknown Shop"
                    %>

                <% } %>

            </p>


            <p>

                <strong>
                    R<%= Number(transaction.amount).toFixed(2) %>
                </strong>

            </p>


            <a href="/transactions/<%= transaction._id %>">
                View Receipt
            </a>

        </div>

        <hr>

    <% }) %>


    <a href="/transactions">
        View All Transactions
    </a>


    <!-- ============================== -->
    <!-- SOCKET / LIVE COUNTS -->
    <!-- ============================== -->

    <script>

        window.dashboardData = {

            currentShopId:
                "<%= shop._id %>"

        };

    </script>


    <script src="/socket.io/socket.io.js"></script>

    <script src="/js/notifications.js"></script>

    <script src="/js/messages.js"></script>


</body>

</html>